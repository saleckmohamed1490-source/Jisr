def t(key, lang="ar", **kwargs):
    text = TRANSLATIONS.get(lang, {}).get(key) or TRANSLATIONS["ar"].get(key) or TRANSLATIONS["en"].get(key) or key
    if kwargs:
        try:
            return text.format(**kwargs)
        except Exception:
            return text
    return text

def get_db():
    if "db" not in g:
        g.db = sqlite3.connect(str(DB_PATH), detect_types=sqlite3.PARSE_DECLTYPES)
        g.db.row_factory = sqlite3.Row
        g.db.execute("PRAGMA foreign_keys = ON")
    return g.db

@app.teardown_appcontext
def close_db(exc):
    db = g.pop("db", None)
    if db is not None:
        db.close()

def init_db():
    db = sqlite3.connect(str(DB_PATH))
    db.executescript("""
    CREATE TABLE IF NOT EXISTS admin (
        id INTEGER PRIMARY KEY CHECK (id = 1),
        username TEXT NOT NULL UNIQUE,
        password_hash TEXT NOT NULL,
        created_at TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS countries (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name_ar TEXT NOT NULL,
        name_fr TEXT DEFAULT '',
        name_en TEXT DEFAULT '',
        flag TEXT DEFAULT '🏳️',
        currency_code TEXT NOT NULL,
        payout_method_ar TEXT NOT NULL,
        payout_method_fr TEXT DEFAULT '',
        payout_method_en TEXT DEFAULT '',
        rate_per_100 REAL NOT NULL DEFAULT 0,
        is_active INTEGER NOT NULL DEFAULT 1,
        sort_order INTEGER NOT NULL DEFAULT 0,
        created_at TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS payment_accounts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name_ar TEXT NOT NULL,
        name_fr TEXT DEFAULT '',
        name_en TEXT DEFAULT '',
        number TEXT NOT NULL,
        is_active INTEGER NOT NULL DEFAULT 1,
        sort_order INTEGER NOT NULL DEFAULT 0,
        created_at TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS orders (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        public_id TEXT NOT NULL UNIQUE,
        country_id INTEGER NOT NULL,
        amount_mru REAL NOT NULL,
        amount_receive REAL NOT NULL,
        rate_used REAL NOT NULL,
        currency_code TEXT NOT NULL,
        mobile_number TEXT NOT NULL,
        receipt_path TEXT,
        status TEXT NOT NULL DEFAULT 'new',
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL,
        FOREIGN KEY (country_id) REFERENCES countries(id)
    );
    CREATE INDEX IF NOT EXISTS idx_orders_status ON orders(status);
    CREATE INDEX IF NOT EXISTS idx_orders_created ON orders(created_at DESC);
    """)
    cur = db.execute("SELECT COUNT(*) FROM countries")
    if cur.fetchone()[0] == 0:
        now = datetime.now(timezone.utc).isoformat()
        db.execute(
            """INSERT INTO countries
            (name_ar, name_fr, name_en, flag, currency_code,
             payout_method_ar, payout_method_fr, payout_method_en,
             rate_per_100, is_active, sort_order, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 0, ?)""",
            ("سيراليون", "Sierra Leone", "Sierra Leone", "🇸🇱", "SLE",
             "أورانج موني", "Orange Money", "Orange Money", 53.0, now)
        )
    cur = db.execute("SELECT COUNT(*) FROM payment_accounts")
    if cur.fetchone()[0] == 0:
        now = datetime.now(timezone.utc).isoformat()
        accounts = [
            ("بنكيلي", "Bankily", "Bankily", "24162122", 0),
            ("سداد", "Sedad", "Sedad", "24162122", 1),
            ("مصريفي", "Masrivi", "Masrivi", "37202223", 2),
        ]
        for name_ar, name_fr, name_en, number, order in accounts:
            db.execute(
                """INSERT INTO payment_accounts
                (name_ar, name_fr, name_en, number, is_active, sort_order, created_at)
                VALUES (?, ?, ?, ?, 1, ?, ?)""",
                (name_ar, name_fr, name_en, number, order, now)
            )
    db.commit()
    db.close()
