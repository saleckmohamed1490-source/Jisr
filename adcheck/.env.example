# ---- AI analysis (Claude) ----
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5
# Server-side refusal fallback (on by default). Set to "off" to disable.
CLAUDE_FALLBACK=on
# Set to 1 to return a canned demo report without calling Claude (local UI work)
AI_MOCK=0

# ---- App ----
# Public URL (used for OAuth / email / checkout redirects). e.g. https://adcheck.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- Rate limits (per user, optional) ----
RATE_LIMIT_CHECKS_PER_MINUTE=5
RATE_LIMIT_CHECKS_PER_HOUR=40
RATE_LIMIT_IMAGES_PER_MINUTE=3
RATE_LIMIT_IMAGES_PER_HOUR=15

# ---- Image generation ----
# openai | replicate | mock
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# ---- Payments ----
# Active provider for new checkouts (only lemonsqueezy today; USDT can be added later)
BILLING_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Variant id of the $6/month subscription product
LEMONSQUEEZY_VARIANT_ID=
# Signing secret of the webhook pointing to https://YOUR-DOMAIN/api/billing/webhook/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=
