# =============================================================================
# AdCheck — environment variables
# Copy to .env.local for local development; set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# Variables starting with NEXT_PUBLIC_ are visible in the browser: never put a
# secret in one. Changing a NEXT_PUBLIC_ value requires a new deployment.
# =============================================================================

# ---- App --------------------------------------------------------------------
# Public URL of the site (OAuth/e-mail redirects, payment return pages, e-mails, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Product name shown everywhere (avoid platform trademarks such as Meta / Facebook)
NEXT_PUBLIC_APP_NAME=AdCheck
# Support address shown on the site, receipts and e-mails
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Comma-separated e-mails allowed to open /admin
ADMIN_EMAILS=you@example.com

# ---- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses row-level security. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI analysis, rewrites and appeal letters (Claude) ----------------------
ANTHROPIC_API_KEY=
# Optional, default claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5
# Server-side refusal fallback to another model (on by default). "off" to disable.
CLAUDE_FALLBACK=on
# 1 = canned demo results, no AI calls (local UI work only — never in production)
AI_MOCK=0

# ---- Image generation ---------------------------------------------------------
# openai | replicate | mock
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# ---- Payments: NOWPayments (crypto) -----------------------------------------
PAYMENT_PROVIDER=nowpayments
# Dashboard → Settings → Payments → API keys
NOWPAYMENTS_API_KEY=
# Dashboard → Settings → Payments → Instant payment notifications → IPN secret key
NOWPAYMENTS_IPN_SECRET=
# true = use the sandbox (api-sandbox.nowpayments.io) with sandbox keys
NOWPAYMENTS_SANDBOX=true

# ---- E-mail (Resend) ----------------------------------------------------------
# Without a key, e-mails are only logged (handy in development)
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "AdCheck <billing@yourdomain.com>"
EMAIL_FROM=AdCheck <onboarding@resend.dev>

# ---- Daily cron (reminders, expiry, credit renewal) ---------------------------
# Long random string. Vercel sends it automatically as "Authorization: Bearer ..."
CRON_SECRET=

# ---- Rate limits per user (optional) ----------------------------------------
RATE_LIMIT_CHECKS_PER_MINUTE=5
RATE_LIMIT_CHECKS_PER_HOUR=40
RATE_LIMIT_IMAGES_PER_MINUTE=3
RATE_LIMIT_IMAGES_PER_HOUR=15
RATE_LIMIT_APPEALS_PER_MINUTE=3
RATE_LIMIT_APPEALS_PER_HOUR=20
